# ── PayPal Sandbox ──────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# ── AI / LLM ───────────────────────────────────────────────────
LLM_API_KEY=
DAILY_LLM_BUDGET=5.00

# ── Catalog ────────────────────────────────────────────────────
CATALOG_API_KEY=

# ── Database ───────────────────────────────────────────────────
# SQLite locally:  sqlite:///./mandate.db
# Postgres on Render:  postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./mandate.db

# ── Security ───────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# ── Tunnel (for webhook dev) ───────────────────────────────────
TUNNEL_URL=
