# ── PayPal Sandbox ──────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# ── AI / LLM ───────────────────────────────────────────────────
# OpenAI-compatible LLM endpoint (default: Google AI Studio)
# OpenRouter users should set LLM_BASE_URL=https://openrouter.ai/api/v1
# and prefix model names with the provider (for example google/gemini-2.5-flash).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_MODEL_FAST=gemini-3.5-flash-lite
DAILY_LLM_BUDGET=5.00

# ── Catalog ────────────────────────────────────────────────────
CATALOG_API_KEY=

# ── Database ───────────────────────────────────────────────────
# SQLite locally:  sqlite:///./mandate.db
# Postgres on Render:  postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./mandate.db

# ── Security ───────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# ── Tunnel (for webhook dev) ───────────────────────────────────
TUNNEL_URL=
